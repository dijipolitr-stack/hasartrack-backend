# HasarTrack Backend — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# ── SUNUCU ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development         # production | development

# ── VERİTABANI ────────────────────────────────────────────────
# Yerel geliştirme:
DATABASE_URL=postgresql://hasartrack:gizli_sifre@localhost:5432/hasartrack_db

# Supabase (canlı). Şifre ve host placeholder'dır. URL'ye sslmode=require EKLEMEYİN
# (pg yeni sürümde sertifika doğrulamaya çevirir, bağlantı kopar).
# Vercel (uygulama): transaction pooler, port 6543
# DATABASE_URL=postgresql://postgres.<proje-ref>:<sifre>@<bolge>.pooler.supabase.com:6543/postgres
# Yerelden migrate/seed: session pooler, port 5432
# DATABASE_URL=postgresql://postgres.<proje-ref>:<sifre>@<bolge>.pooler.supabase.com:5432/postgres
DATABASE_SSL=false           # Supabase için true (rejectUnauthorized:false)
DB_POOL_MAX=10               # Vercel'de 3

# ── İLK ADMIN (npm run db:seed) ──────────────────────────────
ADMIN_EMAIL=admin@hasartrack.com
ADMIN_PASSWORD=              # ZORUNLU, min 12 karakter (yoksa seed hata verir). İlk girişten sonra değiştirin ve silin

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=buraya_cok_uzun_ve_rastgele_bir_string_yazin_min_64_karakter
JWT_EXPIRES=8h

# ── FRONTEND ─────────────────────────────────────────────────
# CORS için; virgülle birden fazla origin yazılabilir, yol ve sonda "/" olmadan
FRONTEND_URL=https://dijipolitr-stack.github.io

# ── DOSYA DEPOLAMA (fotoğraf, evrak) ─────────────────────────
# Canlı: Supabase Storage, özel bucket. Anahtar: Supabase > Project Settings > API > service_role
# (yalnız sunucuda; ön yüze ASLA koymayın). Boş bırakılırsa yerelde backend/.depo klasörü kullanılır,
# production'da yükleme 503 döner.
SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=hasartrack
# DEPO_KLASOR=./.depo

# ── SMS (Türk SMS Sağlayıcıları) ─────────────────────────────
SMS_PROVIDER=netgsm          # netgsm | iletimerkezi | disabled
NETGSM_KULLANICI_ADI=5XXXXXXXXX
NETGSM_SIFRE=xxxxxxxxxx
NETGSM_BASLIK=HasarTrack     # Gönderici adı

# ── E-POSTA (Opsiyonel) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@hasartrack.com
SMTP_PASS=xxxxxxxxxx
